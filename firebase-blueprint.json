{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role and identity info",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 1024 },
        "role": { "type": "string", "enum": ["customer", "photographer", "admin"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "Event": {
      "title": "Event",
      "description": "Published or draft photography event",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "photographerId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "slug": { "type": "string", "maxLength": 256 },
        "description": { "type": "string", "maxLength": 2048 },
        "location": { "type": "string", "maxLength": 256 },
        "eventDate": { "type": "string" },
        "status": { "type": "string", "enum": ["published", "draft", "archived"] },
        "suggestedPriceKes": { "type": "number" },
        "overridePriceKes": { "type": "number" },
        "retentionDeadline": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "photographerId", "title", "eventDate", "status"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order with verified payment status",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "orderNumber": { "type": "string", "maxLength": 64 },
        "customerPhone": { "type": "string", "maxLength": 32 },
        "customerEmail": { "type": "string", "maxLength": 256 },
        "photographerId": { "type": "string", "maxLength": 128 },
        "eventId": { "type": "string", "maxLength": 128 },
        "totalKes": { "type": "number" },
        "commissionAmountKes": { "type": "number" },
        "photographerEarningsKes": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "paid", "failed", "refunded"] },
        "mpesaReference": { "type": "string", "maxLength": 64 },
        "downloadToken": { "type": "string", "maxLength": 128 },
        "downloadExpiresAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "orderNumber", "customerPhone", "totalKes", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents"
    },
    "/events/{eventId}": {
      "schema": "Event",
      "description": "Event catalog and configuration"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Orders and purchases"
    }
  }
}
